# Copy this file to `.env` in the backend/ directory and fill in real values.
# NEVER commit .env or paste real keys into chat.

# Delta Exchange India API credentials
DELTA_API_KEY=
DELTA_API_SECRET=

# Environment: "testnet" or "production"
DELTA_ENV=testnet

DELTA_REST_URL_PRODUCTION=https://api.india.delta.exchange
DELTA_REST_URL_TESTNET=https://cdn-ind.testnet.deltaex.org

DELTA_WS_PUBLIC_URL_PRODUCTION=wss://public-socket.india.delta.exchange
DELTA_WS_PRIVATE_URL_PRODUCTION=wss://socket.india.delta.exchange
DELTA_WS_PUBLIC_URL_TESTNET=wss://socket-ind-pub.testnet.deltaex.org
DELTA_WS_PRIVATE_URL_TESTNET=wss://socket-ind.testnet.deltaex.org

# Symbols to trade (comma separated underlying assets)
SYMBOLS=BTCUSD,ETHUSD,SOLUSD

# Trading mode at startup: always "paper" for safety, flip from the dashboard
DEFAULT_TRADING_MODE=paper

# SQLite DB path (relative to backend/)
DATABASE_URL=sqlite+aiosqlite:///./cryptoalgo.db

# Risk limits (hard ceilings, also enforced in code)
# Leverage is a genuine per-trade tier picked by signal conviction (see
# select_leverage): MIN_LEVERAGE for a marginal-conviction trade up to
# MAX_LEVERAGE for full conviction.
MIN_LEVERAGE=10
MAX_LEVERAGE=50
# Raised alongside MAX_MARGIN_PER_TRADE_PCT (below) so margin, not this
# notional cap, decides how many trades can be open concurrently -- see
# config.py's comment on max_portfolio_leverage for the exact math.
MAX_PORTFOLIO_LEVERAGE=45
# Fraction of equity a single trade may commit as margin. 0.10 with an 0.85
# aggregate cap supports ~8-9 concurrent trades (0.85 / 0.10 = 8.5).
MAX_MARGIN_PER_TRADE_PCT=0.10
MAX_DAILY_LOSS_USD=200
